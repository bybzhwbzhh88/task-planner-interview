{
  "name": "task-planner-interview",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@wasp.sh/spec": "file:.wasp/spec",
    "playwright": "1.64.1",
    "prisma": "5.19.1",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "private": true,
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --e2e",
    "test": "node scripts/verify.mjs --database-only",
    "check:types": "tsc --project tsconfig.src.json --noEmit && tsc --project tsconfig.wasp.json --noEmit",
    "verify:http": "node scripts/verify-quota.mjs --server-log test-results/quota/server.log",
    "verify:browser": "node scripts/verify-browser.cjs",
    "start:logged": "mkdir -p test-results/quota && wasp start 2>&1 | tee test-results/quota/server.log"
  }
}
