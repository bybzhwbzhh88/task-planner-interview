datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GenerationStatus {
  RESERVED
  SUCCEEDED
  RELEASED
}

model User {
  id                 String              @id @default(uuid())
  createdAt          DateTime            @default(now())
  credits            Int                 @default(3)
  planResults        PlanResult[]
  tasks              Task[]
  generationAttempts GenerationAttempt[]
}

model GenerationAttempt {
  id        String           @id
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  status    GenerationStatus @default(RESERVED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  result    PlanResult?

  @@index([userId, status])
}

model PlanResult {
  id                  String             @id @default(uuid())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id])
  userId              String
  content             String
  generationAttemptId String?            @unique
  generationAttempt   GenerationAttempt? @relation(fields: [generationAttemptId], references: [id])
}

model Task {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  description String
  time        String   @default("1")
  isDone      Boolean  @default(false)
}
